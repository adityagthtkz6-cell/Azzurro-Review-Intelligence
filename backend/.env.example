# Application Environment
APP_NAME="Azzurro Review Intelligence API"
APP_ENV="development"
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL recommended for production)
# Make sure credentials remain in environment variables and are never committed.
DATABASE_URL="postgresql+psycopg://azzurro:azzurro_secret_change_me@127.0.0.1:5432/azzurro_reviews"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Playwright Public Review Collector Configuration
COLLECTOR_HEADLESS="true"
COLLECTOR_TIMEOUT_MS="25000"
COLLECTOR_MAX_PAGES_PER_PROPERTY="3"
COLLECTOR_MAX_RETRIES="2"
COLLECTOR_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"

# Sample Fallback Settings
ENABLE_SAMPLE_FALLBACK_ON_BLOCK="true"
