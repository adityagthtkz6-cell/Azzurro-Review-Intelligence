# ==============================================================================
# Azzurro Review Intelligence — Root Environment Configuration Example
# ==============================================================================

# 1. PostgreSQL Docker Compose Variables
POSTGRES_USER=azzurro
POSTGRES_PASSWORD=azzurro_secret_change_me
POSTGRES_DB=azzurro_reviews
POSTGRES_PORT=5432

# 2. FastAPI Backend Variables (copy to backend/.env)
APP_NAME="Azzurro Review Intelligence API"
APP_ENV="development"
API_V1_PREFIX="/api/v1"
DATABASE_URL="postgresql+psycopg://azzurro:azzurro_secret_change_me@127.0.0.1:5432/azzurro_reviews"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3005,http://127.0.0.1:3005"

# 3. Playwright Public Review Collector Variables
COLLECTOR_HEADLESS=true
COLLECTOR_TIMEOUT_MS=25000
COLLECTOR_MAX_PAGES_PER_PROPERTY=3
COLLECTOR_MAX_RETRIES=2
ENABLE_SAMPLE_FALLBACK_ON_BLOCK=true

# 4. Next.js Frontend Variables (copy to frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
